# Copy to .env and supply local values. Never commit real credentials.
# Runtime application account. Grant only the data privileges the application needs.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/wellway2027"
# Prisma CLI/migration account. Keep schema privileges out of DATABASE_URL.
MIGRATION_DATABASE_URL="mysql://MIGRATION_USER:MIGRATION_PASSWORD@127.0.0.1:3306/wellway2027"
# Required for configured auth; generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=""
# Use the exact trusted application origin; HTTPS is required outside localhost.
SITE_URL="http://localhost:3000"
DEFAULT_LOCALE="ar"
# All scaffold pages remain noindex even if this flag is later enabled.
SITE_INDEXABLE="false"

# One-time local administrator bootstrap inputs. Never commit a real password.
INITIAL_ADMIN_EMAIL="online@wellwaysa.com"
INITIAL_ADMIN_PHONE="0501380967"
INITIAL_ADMIN_NAME="Well Way Admin"
INITIAL_ADMIN_PASSWORD=""
